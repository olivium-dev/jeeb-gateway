# Non-secret reviewed B configuration contract. B remains a separate blocked
# change and must never be selected through an A1 workflow input.
ASPNETCORE_ENVIRONMENT=Staging
DemoUsers__Enabled=false
FeatureFlags__UseUpstream__Chat=true
FeatureFlags__UseUpstream__Otp=true
FeatureFlags__UseUpstream__Realtime=true
FeatureFlags__UseUpstream__Voice=true
Operations__RealtimeProbe__MintKeyFile=/run/secrets/staging_wss_probe_mint_key
SuperLogin__OpenMode=false
