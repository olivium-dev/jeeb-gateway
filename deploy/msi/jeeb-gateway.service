[Unit]
Description=Jeeb stateless gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/iter5-native/publish/gateway
EnvironmentFile=/home/ec2-user/iter5-native/env/gateway.env
ExecStart=/home/ec2-user/iter5-native/publish/gateway/JeebGateway
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/iter5-native
UMask=0077

[Install]
WantedBy=multi-user.target
