<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone console tool, NOT wired into any CI/deploy step; owner-run only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccountDeletionRelay</RootNamespace>
    <AssemblyName>AccountDeletionRelay</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JeebGateway\JeebGateway.csproj" />
  </ItemGroup>

</Project>
